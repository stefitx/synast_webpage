st"]}]]}],["$","figure",null,{"className":"card card-hover p-6","children":[["$","blockquote",null,{"className":"text-lg","children":["“","Site-ul nostru aduce, în sfârșit, lead-uri. Plan clar, livrare rapidă, rezultate măsurabile.","”"]}],["$","figcaption",null,{"className":"mt-4 text-sm text-ink-600","children":["— ","Irina G., Practician independent"]}]]}]]}]]}]}],["$","section",null,{"id":"about","className":"section-alt scroll-mt-24 md:scroll-mt-28 ","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"grid items-center gap-8 md:grid-cols-2","children":[["$","div",null,{"children":[["$","h2",null,{"className":"text-3xl font-semibold text-blue-900","children":"Despre Synast"}],["$","p",null,{"className":"mt-4 text-ink-600","children":["Sunt ",["$","strong",null,{"children":"Ștefania Tudor"}],", fondatoarea Synast Digital. Cu o diplomă în business, background în inginerie software și experiență în companii multinaționale de consultanță, eu și echipa mea construim branduri de succes și sisteme accesibile pentru afacerile din România. Începem cu câștiguri rapide, ne adaptăm afacerii tale și aducem îmbunătățiri ce se cumulează."]}]]}],["$","div",null,{"className":"card p-6","children":[["$","div",null,{"className":"text-lg font-medium","children":"Sesiune gratuită de 45 de minute de cunoaștere"}],["$","p",null,{"className":"mt-2 text-ink-600","children":"Identificăm 3 schimbări de impact pe care le poți face luna aceasta."}],["$","$L2",null,{"href":"/contact","className":"mt-4 inline-block btn btn-primary","children":"Programează acum"}]]}]]}]}]}],["$","section",null,{"id":"$undefined","className":"section scroll-mt-24 md:scroll-mt-28 py-24 bg-gradient-to-br from-blue-900 via-blue-700 to-blue-900","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"mx-auto max-w-2xl text-center text-white","children":[["$","h2",null,{"className":"text-4xl font-semibold","children":"Ești gata să-ți urmez